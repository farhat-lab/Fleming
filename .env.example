# Copy to .env (or export in your shell) and fill in your Cognito app client details.
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Only required for confidential app clients (i.e. ones with a client secret configured).
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=https://your-domain.auth.us-east-1.amazoncognito.com
APP_BASE_URL=http://127.0.0.1:7860
SESSION_SECRET_KEY=change-me-to-a-long-random-string
SESSION_COOKIE_SECURE=true
